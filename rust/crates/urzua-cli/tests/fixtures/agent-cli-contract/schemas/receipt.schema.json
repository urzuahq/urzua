{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/urzuahq/agent-cli-kit/main/schemas/receipt.schema.json",
  "title": "Receipt (draft)",
  "type": "object",
  "required": [
    "receipt_version", "run_id", "started_at", "finished_at", "trigger", "commit", "tree",
    "worktree", "dirty", "config_hash", "machine", "tool", "result", "checks", "report"
  ],
  "properties": {
    "receipt_version": {"type": "integer"},
    "run_id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "started_at": {"$ref": "#/$defs/utc_time"},
    "finished_at": {"$ref": "#/$defs/utc_time"},
    "trigger": {"type": "string"},
    "commit": {"type": ["string", "null"]},
    "tree": {"$ref": "#/$defs/tree_hash"},
    "worktree": {"$ref": "#/$defs/tree_hash"},
    "dirty": {"type": "boolean"},
    "config_hash": {"type": "string"},
    "machine": {"type": "string"},
    "tool": {"$ref": "report.schema.json#/$defs/tool"},
    "result": {"enum": ["PASSED", "WARNED", "FAILED"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name", "kind", "command", "scope", "tool_version", "started_at", "finished_at",
          "duration_ms", "exit_code", "status", "examined", "output_tail", "output"
        ],
        "properties": {
          "name": {"type": "string"},
          "kind": {
            "description": "What sort of check this is, so a reader knows what a pass proves.",
            "enum": ["lint", "format", "types", "test", "build", "records", "other"]
          },
          "command": {"type": "string"},
          "scope": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "description": "How the check's inputs were chosen, such as affected. Not the check's kind.",
                "type": "string",
                "minLength": 1
              }
            }
          },
          "tool_version": {"type": ["string", "null"]},
          "started_at": {"$ref": "#/$defs/utc_time"},
          "finished_at": {"$ref": "#/$defs/utc_time"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "exit_code": {
            "description": "The tool's own exit code, not a shell's. Null when killed or never started.",
            "type": ["integer", "null"]
          },
          "status": {"type": "string"},
          "examined": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "output_tail": {"type": "string", "maxLength": 4000},
          "output": {"type": "string", "minLength": 1}
        }
      }
    },
    "report": {"$ref": "gate-report.schema.json"}
  },
  "if": {
    "properties": {"report": {"properties": {"status": {"const": "not-run"}}, "required": ["status"]}},
    "required": ["report"]
  },
  "then": {"properties": {"result": {"const": "FAILED"}}},
  "$defs": {
    "utc_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
    },
    "tree_hash": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
  }
}
