{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/urzuahq/agent-cli-kit/main/schemas/report.schema.json",
  "title": "Report (base layer)",
  "type": "object",
  "required": ["status", "next_action", "next_action_reason", "next_action_inputs"],
  "properties": {
    "status": {"type": "string", "minLength": 1},
    "next_action": {"type": ["string", "null"]},
    "next_action_reason": {"type": ["string", "null"]},
    "next_action_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["placeholder", "flag", "means"],
        "properties": {
          "placeholder": {"type": "string", "pattern": "^<.+>$"},
          "index": {
            "description": "The position in next_action_argv of the element to replace.",
            "type": "integer",
            "minimum": 0
          },
          "flag": {"type": "string"},
          "means": {"type": "string"}
        }
      }
    },
    "next_action_argv": {
      "description": "The command as a program and its arguments, with no shell quoting.",
      "type": ["array", "null"],
      "items": {"type": "string"}
    },
    "error": {"type": "string"},
    "error_kind": {"enum": ["usage", "config", "environment", "internal"]},
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "subject", "message"],
        "properties": {
          "severity": {"type": "string"},
          "subject": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "schema_version": {"type": "integer"},
    "tool": {"$ref": "#/$defs/tool"}
  },
  "allOf": [
    {
      "if": {"properties": {"next_action": {"type": "null"}}, "required": ["next_action"]},
      "then": {"properties": {"next_action_reason": {"type": "null"}}},
      "else": {"properties": {"next_action_reason": {"type": "string"}}}
    },
    {
      "if": {"required": ["error"]},
      "then": {"properties": {"status": {"const": "not-run"}}}
    },
    {
      "if": {"required": ["error_kind"]},
      "then": {"properties": {"status": {"const": "not-run"}}}
    },
    {
      "if": {"required": ["next_action_argv"]},
      "then": {
        "if": {"properties": {"next_action": {"type": "null"}}, "required": ["next_action"]},
        "then": {"properties": {"next_action_argv": {"type": "null"}}},
        "else": {"properties": {"next_action_argv": {"type": "array"}}}
      }
    }
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    }
  }
}
